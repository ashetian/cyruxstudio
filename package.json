{
  "name": "cyruxstudio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/runner.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push || echo '[db:push] Notice: DATABASE_URL is not set or remote DB unreachable. App is configured with resilient in-memory fallback.'",
    "assets:prepare": "bash scripts/prepare-assets.sh",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.78.0",
    "@neondatabase/serverless": "^0.10.4",
    "@prisma/adapter-neon": "^6.4.0",
    "@prisma/client": "^6.4.0",
    "@vercel/blob": "^0.27.1",
    "clsx": "^2.1.1",
    "elevenlabs": "^1.59.0",
    "framer-motion": "^12.4.3",
    "gsap": "^3.12.7",
    "jose": "^5.9.6",
    "lenis": "^1.1.20",
    "lucide-react": "^0.475.0",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.20.1",
