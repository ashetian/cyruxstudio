// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// 1. Product Model (Catalog & Bestseller Grid)
// -----------------------------------------------------------------------------
model Product {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String   @db.Text
  price        Float
  stock        Int      @default(0)
  variants        Json     // Array of variants: [{ id: "s", name: "S", inStock: true, color: "White" }]
  mediaUrls       String[] // Native Postgres string array for product gallery
  isBestseller    Boolean  @default(false)
  color           String?  // Primary colorway name: e.g. "White" | "Black"
  colorHex        String?  // Hex swatch: e.g. "#FAF8F3" | "#0A0A0A"
  twinProductSlug String?  // Complementary twin product slug for colorway pairing
  isDiptych       Boolean  @default(false) // Whether front & back images complete a diptych
  discountPrice   Float?
  category        String      @default("apparel")
  badge           String?
  sku             String?
  sortOrder       Int         @default(0)
  isActive        Boolean     @default(true)
  collectionId    String?
  collection      Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  orderItems      OrderItem[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isBestseller])
  @@index([createdAt])
  @@index([category])
  @@index([collectionId])
  @@index([isActive])
  @@index([sortOrder])
  @@map("products")
}

// -----------------------------------------------------------------------------
// 2. StoreSettings Model (Admin Configuration & WhatsApp Integration)
// -----------------------------------------------------------------------------
model StoreSettings {
  id                    String   @id @default(cuid()) // Single row (e.g. "default")
  whatsappNumber        String   // Target WhatsApp destination (e.g. "+905551234567")
  currency              String   @default("USD")
  brandMetadata         Json     // Title, description, social links, banner text
  freeShippingThreshold Float?
  shippingFee           Float    @default(0)
  lowStockThreshold     Int      @default(3)
  activeTheme           String   @default("white-atelier")
  announcementEnabled   Boolean  @default(true)
  updatedAt             DateTime @updatedAt

  @@map("store_settings")
}

// -----------------------------------------------------------------------------
// 3. ElevenLabsAsset Model (AI Generation Cache & Asset Vault)
// -----------------------------------------------------------------------------
model ElevenLabsAsset {
  id          String   @id @default(cuid())
  promptHash  String   @unique // SHA-256(prompt + params) for instant cache hits
  mediaUrl    String   // Vercel Blob URL or public asset path
  mediaType   String   // "image" | "video"
  creditsUsed Int      // Credits deducted for this generation
  status      String   @default("ready") // "pending" | "ready" | "failed"
  metadata    Json?    // Model ID, generation params, prompt text, latency
  createdAt   DateTime @default(now())

  @@index([mediaType])
  @@index([createdAt])
  @@map("elevenlabs_assets")
}

// -----------------------------------------------------------------------------
// 4. CreditUsageLog Model (Audit Trail & 23k Budget Guard)
// -----------------------------------------------------------------------------
model CreditUsageLog {
  id            String   @id @default(cuid())
  action        String   // "image_generation" | "video_generation" | "system_check"
  creditsUsed   Int      // Amount spent
  balanceBefore Int      // Snapshot before deduction
  balanceAfter  Int      // Snapshot after deduction
  timestamp     DateTime @default(now())

  @@index([timestamp])
  @@map("credit_usage_logs")
}

// -----------------------------------------------------------------------------
// 5. Drop Model (Atelier Drop System & Release Lifecycle)
// -----------------------------------------------------------------------------
model Drop {
  id           String   @id @default(cuid())
  slug         String   @unique
  number       String
  chapter      String
  title        String
  status       String   @default("upcoming") // "active" | "archived" | "upcoming"
  releaseDate  Json     // { tr: string, en: string }
  edition      Json     // { tr: string, en: string }
  description  Json     // { tr: string, en: string }
  productSlugs String[] // Native Postgres string array
  bannerImage  String
  totalPieces  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([slug])
  @@map("drops")
}

// -----------------------------------------------------------------------------
// 6. Collection Model (Curated Atelier Series)
// -----------------------------------------------------------------------------
model Collection {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        Json      // { tr: string, en: string }
  description Json      // { tr: string, en: string }
  imageUrl    String?
  isFeatured  Boolean   @default(false)
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([isFeatured])
  @@index([sortOrder])
  @@map("collections")
}

// -----------------------------------------------------------------------------
// 7. Customer Model (Atelier Client Directory)
// -----------------------------------------------------------------------------
model Customer {
  id          String   @id @default(cuid())
  name        String
  phone       String   @unique
  email       String?
  city        String?
  address     String?  @db.Text
  notes       String?  @db.Text
  totalOrders Int      @default(0)
  totalSpent  Float    @default(0)
  orders      Order[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([phone])
  @@index([createdAt])
  @@map("customers")
}

// -----------------------------------------------------------------------------
// 8. Order & OrderItem Models (WhatsApp & Admin Order Tracking)
// -----------------------------------------------------------------------------
model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  customerId      String?
  customer        Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName    String
  customerPhone   String
  customerEmail   String?
  shippingAddress String?     @db.Text
  status          String      @default("pending") // "pending" | "confirmed" | "preparing" | "shipped" | "delivered" | "cancelled"
  trackingNumber  String?
  trackingCarrier String?
  currency        String      @default("EUR")
  subtotal        Float
  discountAmount  Float       @default(0)
  shippingFee     Float       @default(0)
  total           Float
  couponCode      String?
  whatsappUrl     String?     @db.Text
  customerNotes   String?     @db.Text
  adminNotes      String?     @db.Text
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([status])
  @@index([customerId])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  variantName String?
  quantity    Int      @default(1)
  unitPrice   Float
  lineTotal   Float

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// -----------------------------------------------------------------------------
// 9. Coupon Model (Discount Codes & Campaigns)
// -----------------------------------------------------------------------------
model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  title          Json      // { tr: string, en: string }
  discountType   String    @default("percentage") // "percentage" | "fixed"
  discountValue  Float
  minOrderAmount Float?
  maxUses        Int?
  usedCount      Int       @default(0)
  isActive       Boolean   @default(true)
  startsAt       DateTime?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([code])
  @@index([isActive])
  @@map("coupons")
}

// -----------------------------------------------------------------------------
// 10. StorefrontSection Model (Dynamic CMS Sections)
// -----------------------------------------------------------------------------
model StorefrontSection {
  key       String   @id // "hero" | "marquee" | "lookbook" | "about" | "faq" | "contact" | "legal" | "footer" | "navigation" | "seo" | "collectionsSection"
  data      Json
  isEnabled Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@map("storefront_sections")
}

